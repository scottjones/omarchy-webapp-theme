{
  "manifest_version": 3,
  "name": "Omarchy Web App Theme",
  "version": "0.3.7",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "Make web apps (Slack, WhatsApp, ...) follow the current Omarchy theme: palette, light/dark, and accent.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://app.slack.com/*",
    "*://web.whatsapp.com/*",
    "*://github.com/*",
    "*://gist.github.com/*",
    "*://linear.app/*",
    "*://*.linear.app/*",
    "*://discord.com/*",
    "*://outlook.office.com/*",
    "*://outlook.office365.com/*",
    "*://outlook.live.com/*",
    "*://outlook.cloud.microsoft/*",
    "*://app.notion.com/*",
    "*://www.notion.so/*",
    "*://notion.so/*",
    "*://app.hey.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.slack.com/*",
        "*://web.whatsapp.com/*",
        "*://github.com/*",
        "*://gist.github.com/*",
        "*://linear.app/*",
        "*://*.linear.app/*",
        "*://discord.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.live.com/*",
        "*://outlook.cloud.microsoft/*",
        "*://app.notion.com/*",
        "*://www.notion.so/*",
        "*://notion.so/*",
        "*://app.hey.com/*"
      ],
      "js": [
        "inject-prefers-color-scheme.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://app.slack.com/*",
        "*://web.whatsapp.com/*",
        "*://github.com/*",
        "*://gist.github.com/*",
        "*://linear.app/*",
        "*://*.linear.app/*",
        "*://discord.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.live.com/*",
        "*://outlook.cloud.microsoft/*",
        "*://app.notion.com/*",
        "*://www.notion.so/*",
        "*://notion.so/*",
        "*://app.hey.com/*"
      ],
      "js": [
        "omarchy-colors.js",
        "omarchy-surfaces.js",
        "omarchy-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://app.slack.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://github.com/*",
        "*://gist.github.com/*"
      ],
      "js": [
        "github.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://linear.app/*",
        "*://*.linear.app/*"
      ],
      "js": [
        "linear.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://discord.com/*"
      ],
      "js": [
        "discord.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*",
        "*://outlook.live.com/*",
        "*://outlook.cloud.microsoft/*"
      ],
      "js": [
        "outlook.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://app.notion.com/*",
        "*://www.notion.so/*",
        "*://notion.so/*"
      ],
      "js": [
        "notion.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://app.hey.com/*"
      ],
      "js": [
        "hey.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Omarchy Web App Theme",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
